# LLM MEĐUKORACI se ne verzioniraju (pilot/, failed/, validated/, raw/, batch
# reporti, manual_review.sqlite) — velike, nereproducibilne sirovine.
# IZNIMKA: `final_dataset.json` je KANONSKI artefakt rada (jedini izvor koji
# `scripts/import_dataset.py` čita) i MORA biti pod verzijom — bez njega repo
# ne može rekonstruirati eval-spreman sustav (NALAZ #20, Faza 4.4-0f).
data/generated_tasks/*
!data/generated_tasks/final_dataset.json
data/generated_tasks.*backup*/

# Docker
docker-volumes/

# 🔴 EVAL PODACI — NIKAD U GIT (NALAZ #37)
# Dumpovi sadrže e-mailove, username-e i password hasheve sudionika evaluacije.
# Exporti su pseudonimizirani, ali `*_pseudonym_map.csv` NIJE — on je jedina
# datoteka koja povezuje pseudonim (P01) sa stvarnim identitetom.
#
# 🔴 Backup se MORA kopirati na DRUGI MEDIJ nakon svake eval sesije —
#    `.gitignore` znači da ga git NE čuva. Vidi docs/eval-runbook.md.
backups/
exports/

# Smoke correlation_id zabilježen na dan evala (vidi docs/eval-runbook.md).
# NE commitati: vrijednost je specifična za jedno podizanje sustava, a stara
# vrijednost aktivno zavarava — isključila bi nepostojeći tok i ostavila dojam
# da je promet filtriran kad nije.
docs/eval-smoke-cid.txt

