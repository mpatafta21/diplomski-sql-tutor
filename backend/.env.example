# Glavna baza (tutor_main) — koristi se za Alembic i app session
DATABASE_URL=postgresql+psycopg://tutor:tutor_dev_password@localhost:5432/tutor_main

# Sandbox (read-only exec) — popunit će se u Fazi 1B/2
SANDBOX_DATABASE_URL=postgresql+psycopg://sandbox_admin:sandbox_dev_password@localhost:5433/sandbox

ANTHROPIC_API_KEY=sk-ant-api03-tvoj-pravi-kljuc-ovdje

# XMPP / Prosody (SPADE agenti)
XMPP_SERVER=localhost
XMPP_PORT=5222
# dev-only: dopušta PLAIN bez TLS-a; produkcija zahtijeva TLS+SCRAM i XMPP_ALLOW_PLAINTEXT=false
XMPP_ALLOW_PLAINTEXT=false

AGENT_EVALUATOR_JID=evaluator@localhost
AGENT_EVALUATOR_PASSWORD=tvoja-lozinka

AGENT_COORDINATOR_JID=coordinator@localhost
AGENT_COORDINATOR_PASSWORD=tvoja-lozinka

AGENT_KNOWLEDGE_JID=knowledge@localhost
AGENT_KNOWLEDGE_PASSWORD=tvoja-lozinka

AGENT_RECOMMENDER_JID=recommender@localhost
AGENT_RECOMMENDER_PASSWORD=tvoja-lozinka

AGENT_GAMIFICATION_JID=gamification@localhost
AGENT_GAMIFICATION_PASSWORD=tvoja-lozinka

# JWT auth (Faza 4.0b) — JWT_SECRET je OBAVEZAN; generiraj jak nasumičan string za prod
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
# Trajanje access tokena u minutama (default 1440 = 24h, pokriva eval sesije)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seed admin (Faza 4.0b) — kreira se jednom, idempotentno; password NIKAD u git
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sql-tutor.local
ADMIN_PASSWORD=change-me-in-prod